{
  "name": "moliya-pro",
  "version": "2.0.0",
  "description": "Moliya-Pro — Google Sheets asosidagi moliyaviy boshqaruv tizimi (TypeScript, Google Apps Script)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "push": "npm run build && clasp push -f",
    "deploy": "npm run build && clasp deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.83",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
